# 这是示例配置文件
# 复制此文件为 .env.local 并填入真实值

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Paddle v1.0
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_STARTER=
PADDLE_PRICE_CREDITS_POPULAR=
PADDLE_PRICE_CREDITS_PRO=
PADDLE_PRICE_SUB_MINI_MONTHLY=
PADDLE_PRICE_SUB_STANDARD_MONTHLY=
PADDLE_PRICE_SUB_PLUS_MONTHLY=
PADDLE_PRICE_PROFILE_REVIEW_UNLOCK=

# Stripe legacy fallback, not used by Paddle v1.0 frontend
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Volcengine
VOLC_ACCESS_KEY=placeholder
VOLC_SECRET_KEY=placeholder
VOLC_REGION=cn-north-1

# ImgBB (Free Image Hosting)
# Get API key from: https://api.imgbb.com/
# Free tier: Unlimited storage, Unlimited bandwidth
IMGBB_API_KEY=placeholder

# Gemini image generation
# Production/Vercel calls Google directly server-side. Local development can use
# GEMINI_RELAY_URL when the local network cannot reach generativelanguage.googleapis.com.
GEMINI_API_KEY=placeholder
GEMINI_RELAY_SECRET=replace-with-a-long-random-shared-secret
GEMINI_RELAY_URL=https://your-vercel-domain.vercel.app
# GEMINI_AUTO_PROXY=1
# GEMINI_AUTO_PROXY_URLS=http://127.0.0.1:7890,http://127.0.0.1:7891
# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROFILE_REVIEW_SCORE_MAX=100
